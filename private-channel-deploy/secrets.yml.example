# Plain-text secrets template. Copy to `secrets.yml` and fill in real values:
#   cp secrets.yml.example secrets.yml
# `secrets.yml` is gitignored — DO NOT COMMIT it.
# See README "Future improvements" for the SOPS+age upgrade path.
#
# Optional Doppler backend (opt-in, per-operator): instead of this file, the
# deploy can pull these same keys from Doppler at deploy time. Set DOPPLER_TOKEN
# (a read-only service token scoped to your project/config) in your shell and the
# playbook auto-uses it; unset, it falls back to this file. Doppler key names are
# the UPPERCASE of the keys below (postgres_password -> POSTGRES_PASSWORD, etc.),
# except notify_webhook (ALERT_WEBHOOK_URL) and alert_webhook_url
# (GRAFANA_ALERT_WEBHOOK_URL). scripts/doppler-import.sh uploads this file with
# those names. See README "Secrets backends".
#
# On the host each container reads only its own secrets, from files under
# <host_data_dir>/secrets/<service>/ (root-only). The rendered .env holds none.
# Rotate any of these with scripts/rotate-secret.sh (docs/runbooks/secret_rotation.md).
#
# Required: postgres_password, postgres_replication_password,
#           postgres_runtime_password, postgres_auth_runtime_password,
#           postgres_auth_owner_password, postgres_gateway_password,
#           postgres_monitoring_password, postgres_grafana_password,
#           postgres_indexer_password, jwt_secret,
#           grafana_admin_password, ghcr_user, ghcr_token.
# Optional: yellowstone_token (devnet/mainnet only), notify_webhook, alert_webhook_url,
#           jwt_secret_previous (only during a JWT rotation), rpc_url,
#           fallback_rpc_url, gateway_whitelist_rpc_url (when they carry an API key),
#           escrow_confidential_keys, escrow_confidential_pubkey.
# Per signer backend: admin_/operator_ vault_token, turnkey_api_private_key or
#           privy_app_secret, required when that role's signer uses the backend.
# ghcr_user/ghcr_token are required only when image_registry is on ghcr.io.

# The PRIMARY cluster's superuser password. Bootstraps it and is still used by
# the pieces that need it: the primary's pg-backup sidecar and the replica's
# startup wait. Nothing that serves requests connects as it — a superuser
# bypasses every grant the per-service logins below rely on, and the indexer
# cluster has its own so a compromise there cannot reach the primary.
# Generate fresh: openssl rand -hex 16
postgres_password: ""

# Streaming-replication password used by postgres-replica.
# Read by init-primary.sql via the POSTGRES_REPLICATION_PASSWORD env var, so
# changing it here is sufficient — no other file needs to match.
# Generate fresh: openssl rand -hex 16
postgres_replication_password: ""

# One password per service login, created by init-auth-roles.sql. Give each its
# own value: sharing one hands a compromised service the others' rights, and the
# deploy asserts they differ.
#   private_channel_runtime       write-node, read-node, streamer
#   private_channel_auth_runtime  auth service
#   private_channel_auth_owner    owns the auth schema; migrations + admin CLI
#   private_channel_gateway       gateway; SELECT only
#   private_channel_monitoring    postgres_exporter; pg_monitor only
# The last one is created by init-indexer-roles.sql, on the indexer cluster:
#   private_channel_grafana       Grafana's datasource; SELECT on the
#                                 transaction_monitoring view only
# Generate each fresh: openssl rand -hex 16
postgres_runtime_password: ""
postgres_auth_runtime_password: ""
postgres_auth_owner_password: ""
postgres_gateway_password: ""
postgres_monitoring_password: ""
postgres_grafana_password: ""
# The indexer cluster's own superuser password. Must not equal postgres_password:
# the indexer processes reach postgres-primary too, so a shared value hands them
# the auth tables.
postgres_indexer_password: ""

# Gateway JWT signing secret. 32+ random bytes.
# Only used when the auth service is enabled (gateway_enforce_jwt=true in vars/<env>.yml).
# Safe to leave at any non-empty value when the auth service is off.
# Generate fresh: openssl rand -hex 32
jwt_secret: ""

# The previous JWT secret, set only while a rotation is in progress. Auth signs with
# jwt_secret only; auth and the gateway verify with jwt_secret, then this one, so
# tokens issued before the rotation keep working until it is cleared. Refused when
# under 32 bytes, equal to jwt_secret, or set without jwt_secret.
# Do not edit by hand: `scripts/rotate-secret.sh jwt_secret` sets it and
# `scripts/rotate-secret.sh jwt_secret --finish` clears it. After a key compromise,
# leave it empty (hard cut). Doppler: JWT_SECRET_PREVIOUS.
jwt_secret_previous: ""

# Grafana admin password. URL: http://<host>:<monitoring_grafana_port>, user: admin.
# Forced password change on first login; rotate by editing here + redeploying.
grafana_admin_password: ""

# GHCR credentials. Required — the deploy pulls images from GHCR.
#   ghcr_user  = your GitHub username (or an org bot account).
#   ghcr_token = classic GitHub PAT with ONLY `read:packages`. The deploy refuses any
#                other scope set, and fine-grained (github_pat_) tokens. CI pushes with
#                its own GITHUB_TOKEN, never this PAT. Prefer an org-scoped bot account.
# Create the PAT: https://github.com/settings/tokens/new?scopes=read:packages
# The token is used only for the pull, from a throwaway docker config that is deleted
# afterwards. A rotated PAT takes effect on the next deploy.
# GHCR overview: https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-container-registry
ghcr_user: ""
ghcr_token: ""

# Yellowstone gRPC auth token (e.g. Helius `x-token`).
# Required when network=devnet/mainnet (paid providers all gate gRPC behind a token).
# Leave empty on localnet — the bundled validator's Yellowstone needs no auth.
yellowstone_token: ""

# Provider RPC URLs. Paid providers put the API key in the URL, so these are
# secrets: each reaches only the containers that use it, as a file. They may
# instead stay in vars/<env>.yml (plain localnet or public URLs). A key set here
# overrides vars/<env>.yml, so leave a line commented out unless you set it.
#   rpc_url                   : the Solana RPC for `network`. Doppler: RPC_URL.
#   fallback_rpc_url          : independent archival RPC, required off localnet.
#                               Doppler: FALLBACK_RPC_URL.
#   gateway_whitelist_rpc_url : optional Mainnet RPC for the gateway's withdraw
#                               whitelist check. Doppler: GATEWAY_WHITELIST_RPC_URL.
# rpc_url: "https://<provider-host>/?api-key=<key>"
# fallback_rpc_url: "https://<other-provider-host>/<key>"
# gateway_whitelist_rpc_url: "https://<mainnet-provider-host>/?api-key=<key>"

# notify_webhook — single endpoint for deploy-time and runtime alerts.
#   Deploy-time : site.yml POSTs the report-phase summary here when non-empty.
#   Runtime     : delivered as a secret file for ALERT_WEBHOOK_URL (indexers and
#                 operators) and OPERATOR_RECONCILIATION_WEBHOOK_URL (operator-solana):
#                 row alerts and reconciliation halts. Grafana's contact point is the
#                 separate `alert_webhook_url` below, not this one. Best-effort POST
#                 today: no retry, no rate-limit, no dedup. See README "Future improvements".
# Benefit: one URL to change to redirect all alerts (Slack/Discord/Opsgenie webhooks).
# Leave empty to skip the deploy POST; runtime services fall back to a no-op URL.
# A secret: webhook URLs carry their own credential. Doppler: ALERT_WEBHOOK_URL
# (NOTIFY_WEBHOOK also accepted).
notify_webhook: ""

# alert_webhook_url: Grafana's contact point (pair with alert_contact_type in vars).
# Rendered into the monitoring stack's Grafana only. Empty keeps the no-op default.
# Doppler: GRAFANA_ALERT_WEBHOOK_URL.
alert_webhook_url: ""

# === Signer secrets ===================================================
# The admin (channel admin) and operator (withdraw operator) roles each pick a
# backend with admin_signer / operator_signer in vars (default memory; mainnet
# refuses memory). Only the secret part of a remote backend goes here; its other
# settings are plain vars (see examples/signers/). Fill only the lines for the
# backends you use. Doppler names are the upper case (ADMIN_VAULT_TOKEN, ...).
#
# memory: no entry here. The key is read from <role>_keypair_path in vars, or from
#   Doppler ADMIN_KEYPAIR / OPERATOR_KEYPAIR (the keypair JSON byte array). Refused
#   on mainnet.

# vault: a token allowed to sign with the transit/ key named by <role>_vault_key_name.
admin_vault_token: ""
operator_vault_token: ""

# turnkey: the API key pair's private half (the public half is a plain var).
admin_turnkey_api_private_key: ""
operator_turnkey_api_private_key: ""

# privy: the app secret for <role>_privy_app_id.
admin_privy_app_secret: ""
operator_privy_app_secret: ""
=======
# Escrow instance confidential keys, read by indexer-solana and both operators.
# Leave empty until an escrow account is configured for confidential transfers;
# after that the services refuse to start without the key that account holds.
# Format: {"elgamal_secret":"<base64 32 bytes>","aes_key":"<base64 16 bytes>"}
# Generate once per instance: cargo run -p devnet-scripts --bin confidential_keygen
# Never rotate it while an account is configured: deposits would become unreadable.
escrow_confidential_keys: ""

# The instance's ElGamal pubkey, the ESCROW_CONFIDENTIAL_PUBKEY value
# confidential_keygen prints (base64, not secret). Set it with the keys, before the
# first configure: the services then refuse to start without the matching keys,
# even on an empty database.
escrow_confidential_pubkey: ""
