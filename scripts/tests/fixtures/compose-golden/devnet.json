{
  "name": "private-channel",
  "networks": {
    "private-channel-network": {
      "name": "private-channel_private-channel-network",
      "driver": "bridge",
      "ipam": {}
    }
  },
  "services": {
    "auth": {
      "profiles": [
        "auth"
      ],
      "build": {
        "context": "REPO",
        "dockerfile": "Dockerfile",
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        }
      },
      "command": [
        "/usr/local/bin/auth"
      ],
      "container_name": "private-channel-auth",
      "depends_on": {
        "auth-migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres-primary": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_ARGON2_MAX_CONCURRENCY": "4",
        "AUTH_DATABASE_MAX_CONNECTIONS": "10",
        "AUTH_DATABASE_URL": "postgres://private_channel_auth_runtime:@postgres-primary:5432/private_channel",
        "AUTH_HEADER_READ_TIMEOUT_SECS": "10",
        "AUTH_MAX_CONNECTIONS": "1024",
        "AUTH_MAX_CONNECTIONS_PER_IP": "64",
        "AUTH_PORT": "8903",
        "AUTH_RATE_LIMIT_BURST": "10",
        "AUTH_RATE_LIMIT_PER_SECOND": "5",
        "AUTH_REQUEST_TIMEOUT_SECS": "15",
        "AUTH_TCP_KEEPALIVE_IDLE_SECS": "60",
        "AUTH_TCP_KEEPALIVE_INTERVAL_SECS": "15",
        "AUTH_USERNAME_FAILED_LOGINS_PER_MINUTE": "5",
        "CORS_ALLOWED_ORIGIN": "*",
        "JWT_SECRET": "",
        "RUST_LOG": "info"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:8903/health || exit 1"
        ],
        "timeout": "3s",
        "interval": "10s",
        "retries": 5,
        "start_period": "30s"
      },
      "image": "private-channel-app:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 8903,
          "published": "8903",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "ulimits": {
        "nofile": {
          "soft": 65536,
          "hard": 65536
        }
      }
    },
    "auth-migrate": {
      "profiles": [
        "auth"
      ],
      "build": {
        "context": "REPO",
        "dockerfile": "Dockerfile",
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        }
      },
      "command": [
        "/usr/local/bin/auth-admin",
        "migrate"
      ],
      "container_name": "private-channel-auth-migrate",
      "depends_on": {
        "postgres-primary": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_DATABASE_URL": "postgres://private_channel_auth_owner:@postgres-primary:5432/private_channel",
        "RUST_LOG": "info"
      },
      "image": "private-channel-app:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "restart": "no"
    },
    "blackbox-exporter": {
      "command": null,
      "container_name": "private-channel-blackbox-exporter",
      "entrypoint": null,
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget --spider -q http://localhost:9115/-/healthy || exit 1"
        ],
        "timeout": "3s",
        "interval": "30s",
        "retries": 5,
        "start_period": "10s"
      },
      "image": "prom/blackbox-exporter:v0.25.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "restart": "unless-stopped"
    },
    "cadvisor": {
      "command": null,
      "container_name": "private-channel-cadvisor",
      "entrypoint": null,
      "image": "gcr.io/cadvisor/cadvisor:v0.49.1",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "8080",
          "protocol": "tcp"
        }
      ],
      "privileged": true,
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "/",
          "target": "/rootfs",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/var/run",
          "target": "/var/run",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/sys",
          "target": "/sys",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/var/lib/docker/",
          "target": "/var/lib/docker",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/dev/disk/",
          "target": "/dev/disk",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "gateway": {
      "build": {
        "context": "REPO",
        "dockerfile": "Dockerfile",
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        }
      },
      "command": [
        "/usr/local/bin/gateway"
