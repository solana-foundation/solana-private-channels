    "postgres-replica": {
      "command": [
        "bash",
        "-c",
        "\n  until PGPASSWORD= psql -h postgres-primary -U private_channel -d private_channel -c 'SELECT 1' \u003e /dev/null 2\u003e\u00261; do\n    echo 'Waiting for primary to be ready...'\n    sleep 2\n  done\n\n  if [ ! -f /var/lib/postgresql/data/PG_VERSION ]; then\n    echo 'Setting up replica...'\n    rm -rf /var/lib/postgresql/data/*\n    # Slots are not in base backups, so a restored primary has none; recreate it.\n    PGPASSWORD= psql -h postgres-primary -U private_channel -d private_channel -c \"SELECT pg_create_physical_replication_slot('replica_slot', true) WHERE NOT EXISTS (SELECT 1 FROM pg_replication_slots WHERE slot_name = 'replica_slot')\"\n    PGPASSWORD= pg_basebackup -h postgres-primary -D /var/lib/postgresql/data -U replicator -v -P -R -S replica_slot\n\n    chmod 700 /var/lib/postgresql/data\n    touch /var/lib/postgresql/data/standby.signal\n  fi\n\n  postgres\n"
      ],
      "container_name": "private-channel-postgres-replica",
      "depends_on": {
        "postgres-primary": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "PGUSER": "private_channel",
        "POSTGRES_DB": "private_channel",
        "POSTGRES_MASTER_HOST": "postgres-primary",
        "POSTGRES_MASTER_PORT": "5432",
        "POSTGRES_PASSWORD": "",
        "POSTGRES_REPLICATION_MODE": "slave",
        "POSTGRES_REPLICATION_PASSWORD": "",
        "POSTGRES_REPLICATION_USER": "replicator",
        "POSTGRES_USER": "private_channel"
      },
