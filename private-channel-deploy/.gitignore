# Ansible run logs (configured via ansible.cfg log_path).
ansible.log
*.log

# Ansible scratch + retry files.
*.retry
.ansible/

# Plain-text secrets files — must never be committed. See README "Future
# improvements" for the SOPS upgrade path that lets this go in git encrypted.
secrets.yml
*-secrets.yml

# Per-environment vars files carry host IPs, instance ids and keypair paths for
# stacks that aren't the reference ones. Only common.yml and dev.yml are tracked.
vars/*.yml
!vars/common.yml
!vars/dev.yml

# Reserved for the SOPS upgrade. Keys must never live in the repo.
age.key
keys.txt

# Editor / OS noise.
.DS_Store
*.swp

# Per-environment inventories carry real host IPs. inventory.ini stays the
# tracked placeholder.
inventory.*.ini
