# Pinned external image and toolchain versions (single source of truth).
#
# Consumed by:
#   - Dockerfile, validator.Dockerfile, Dockerfile.grafana, Dockerfile.prometheus (via ARG)
#   - docker-compose.yml, docker-compose.devnet.yml (via --env-file versions.env)
#   - Makefile targets: install-toolchain, check-toolchain, yellowstone-prepare
#   - .github/actions/setup-solana/action.yml
#
# Do NOT duplicate these values elsewhere. Update this file and rebuild.

# --- Solana toolchain ---
# SOLANA_VERSION is the Solana CLI binary version (ships `solana-test-validator`
# + `cargo-build-sbf`). YELLOWSTONE_TAG is the Geyser plugin tag; it MUST be
# compiled against the same Solana version the CLI installs.
#
# NOTE: The workspace `Cargo.toml` solana-* Rust crate set tracks the same
# release. The monorepo crates move in lockstep with the CLI; the split SDK
# crates are versioned independently and land on their own numbers.
SOLANA_VERSION=4.2.2
YELLOWSTONE_TAG=v15.2.1+solana.4.2.2

# --- pnpm ---
# pnpm CLI version installed in the main Dockerfile.
# Must match the `packageManager` field in each package.json (see README "Tool versions").
PNPM_VERSION=10.15.1

# --- Observability stack ---
# Pinning replaces `:latest` to keep the stack reproducible. Bump these
# periodically for security updates.
GRAFANA_VERSION=11.4.0
PROMETHEUS_VERSION=v3.0.1
BLACKBOX_VERSION=v0.25.0

# --- k3s deploy (private-channel-deploy/k3s.yml) ---
# k3s server and the client tools the control node uses through the SSH tunnel.
K3S_VERSION=v1.35.9+k3s1
# sha256 of install.sh at the K3S_VERSION tag; bump both together.
K3S_INSTALL_SH_SHA256=8598e002e61d658fed7b7542fc6d2c66d8da6eae69e088830105d2ee1ffb6d91
HELM_VERSION=v3.22.1
KUBECTL_VERSION=v1.35.4
CRANE_VERSION=v0.22.1
# Chart test tools (scripts/tests/k3s-chart.test.sh) and the Ansible collection k3s.yml uses.
HELM_UNITTEST_VERSION=1.2.1
KUBECONFORM_VERSION=v0.8.0
KUBERNETES_CORE_VERSION=6.3.0
# Cluster add-ons installed by bootstrap. CNPG 1.26 or newer is required by the backup plugin.
CNPG_CHART_VERSION=0.29.0
BARMAN_PLUGIN_VERSION=0.8.1
CERT_MANAGER_CHART_VERSION=v1.21.3
KPS_CHART_VERSION=93.1.1
