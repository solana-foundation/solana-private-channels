# Image tag for the private-channel-app containers (compose defaults to `latest`).
PRIVATE_CHANNEL_VERSION=latest

# Instance
ESCROW_INSTANCE_ID=instance_pubkey
# Escrow instance PDA the compose stack reads as COMMON_ESCROW_INSTANCE_ID.
# Created post-deploy via `create_instance`; compose interpolation needs it set,
# so default to the all-1s placeholder until the real PDA is written back.
COMMON_ESCROW_INSTANCE_ID=11111111111111111111111111111111
# The channel admin service key: SPL mint+freeze authority on every receipt mint,
# and the fee payer for the operator's own transactions.
#
# This is NOT the escrow instance admin. That is a separate offline keypair
# (keypairs/escrow-admin.json) which no service ever loads, so it has no env var
# here. Reusing one key for both roles defeats SetNewAdmin: the rotated-out key
# keeps its receipt-mint authority and its Operator PDA, so it can still drain
# escrow custody after the handover.
#
# Keep blank here: `make build-*` writes the live key to the gitignored `.env`.
ADMIN_PRIVATE_KEY=

# RPC endpoints
DEVNET_RPC_URL=solana_rpc_url
DEVNET_YELLOWSTONE_ENDPOINT=yellowstone_url
INDEXER_YELLOWSTONE_TOKEN=yellowstone_x_token
# Archival Solana RPC (COMMON_FALLBACK_RPC_URL). Re-checks a Dead finality verdict. REQUIRED for the withdraw
# operator: independent from and same-cluster as DEVNET_RPC_URL, or it refuses to start; optional for escrow.
DEVNET_FALLBACK_RPC_URL=https://api.devnet.solana.com
# Local validator RPC (Only if running docker locally)
LOCAL_VALIDATOR_RPC_URL=http://validator:8899
# Controls whether the local validator wipes its ledger on container start.
# Default `--reset` matches today's behavior (fresh ledger every `docker-up`).
# Set to blank to preserve /validator-data across restarts so on-chain state
# stays consistent with Postgres. After changing escrow/withdraw program code,
# run `make docker-clean` to force a fresh deploy. The `make docker-up-persist`
# target sets this for you.
VALIDATOR_RESET_FLAG=--reset

# PostgreSQL
POSTGRES_DB=private_channel
POSTGRES_USER=private_channel
# Required: set before startup. No default is shipped; services fail closed if blank.
POSTGRES_PASSWORD=
POSTGRES_REPLICATION_USER=replicator
# Required: set before startup. No default is shipped; services fail closed if blank.
POSTGRES_REPLICATION_PASSWORD=
POSTGRES_INDEXER_DB=indexer

# Solana Private Channels Node
PRIVATE_CHANNEL_WRITE_PORT=8900
PRIVATE_CHANNEL_READ_PORT=8901
PRIVATE_CHANNEL_SIGVERIFY_QUEUE_SIZE=10000000
PRIVATE_CHANNEL_SIGVERIFY_WORKERS=32
PRIVATE_CHANNEL_WRITE_MAX_CONNECTIONS=1000000
PRIVATE_CHANNEL_READ_MAX_CONNECTIONS=100000
# Postgres pool size per node (default 32, capped at 256).
PRIVATE_CHANNEL_PG_MAX_CONNECTIONS=32
PRIVATE_CHANNEL_MAX_TX_PER_BATCH=64
# Sequencer batch-flush deadline (ms).
PRIVATE_CHANNEL_BATCH_DEADLINE_MS=10
# Sequencer→executor batch channel capacity.
PRIVATE_CHANNEL_BATCH_CHANNEL_CAPACITY=16
# Executor parallel SVM worker cap.
PRIVATE_CHANNEL_MAX_SVM_WORKERS=8
# Optional Redis read cache in front of Postgres. Leave unset to run
# Postgres-only. Both the write node and the read node take this one value, so
# they cannot end up pointing at different caches. Needs a Redis instance; the
# compose stack does not ship one.
# PRIVATE_CHANNEL_REDIS_CACHE_URL=redis://redis:6379
# Space-separated channel admin pubkey(s): the write-node's InitializeMint gate.
# `make build-localnet` fills this (and ADMIN_PRIVATE_KEY) with a generated keypair.
# Must not list the escrow instance admin, which is a separate offline key.
PRIVATE_CHANNEL_ADMIN_KEYS=admin_pubkey

# Gateway
GATEWAY_PORT=8899
GATEWAY_WRITE_URL=http://write-node:8900
GATEWAY_READ_URL=http://read-node:8901
GATEWAY_URL=http://gateway:8899
# Internal listener: no RBAC, and transaction errors are not collapsed. For the
# operator's own services, which carry no JWT and route on the exact error.
#
# It is internal only because compose gives it no `ports:` entry, so it exists
# on the Docker network and nowhere else. Publishing it to the host would let
# any caller read the raw errors and undo the redaction on the public port.
GATEWAY_INTERNAL_PORT=8904
GATEWAY_INTERNAL_URL=http://gateway:8904

# Streamer
STREAMER_PORT=8902

# Auth Service
# Leave JWT_SECRET blank to disable RBAC enforcement on the gateway.
# WARNING: the value below is a placeholder. Any non-throwaway deployment
# (devnet, staging, prod) MUST replace it with a long random string —
# `openssl rand -hex 32` is fine. Leaving the placeholder is equivalent
# to publishing your signing key.
AUTH_PORT=8903
# Required only when enabling auth: set before startup. No default is shipped.
JWT_SECRET=
# Restrict the auth service CORS origin. Set to your frontend URL in production
# (e.g. https://app.solana-private-channel). Defaults to * if unset (local dev only).
CORS_ALLOWED_ORIGIN=https://your-frontend-url.com
# DB pool size for the auth service and the gateway's auth DB connection.
# Default is 10. Increase under high concurrency.
AUTH_DATABASE_MAX_CONNECTIONS=10
# Concurrent Argon2 hashes. Hashing is CPU-bound, so past the core count this
# costs memory without adding throughput. Must be greater than zero.
AUTH_ARGON2_MAX_CONCURRENCY=4
# Per-IP request budget for /auth/register and /auth/login.
AUTH_RATE_LIMIT_PER_SECOND=5
AUTH_RATE_LIMIT_BURST=10
# Credential attempts per minute against a single username, across all IPs.
AUTH_USERNAME_ATTEMPTS_PER_MINUTE=5
# Connection limits for the auth listener. The rate limits above are per
# request, so these are what bound clients that connect and stay idle or
# trickle their headers without ever completing one.
AUTH_MAX_CONNECTIONS=1024
AUTH_MAX_CONNECTIONS_PER_IP=64
# Seconds to send a full header block (slowloris protection). Also the idle
# timeout for kept-alive connections, so keep a client's pool idle below it.
AUTH_HEADER_READ_TIMEOUT_SECS=10
# Seconds a request may take once its headers are in, shed as 503. Must exceed
# the 5s pool acquire timeout, or the service refuses to start: a shorter value
# cancels a request before an exhausted pool can report itself to /health.
AUTH_REQUEST_TIMEOUT_SECS=15
AUTH_TCP_KEEPALIVE_IDLE_SECS=60
AUTH_TCP_KEEPALIVE_INTERVAL_SECS=15

# Grafana
GF_ADMIN_PASSWORD=admin

# Alerting
ALERT_WEBHOOK_URL=https://your-webhook-url.com/endpoint
# Required for the escrow operator: reconciliation mismatch/halt alerts. The
# escrow operator refuses to start without this. Dev may point at any sink.
RECONCILIATION_WEBHOOK_URL=http://localhost:9/no-op

# Program IDs (under target/deploy/...-keypair.json)
# Only if running docker locally, as it deploys those programs
# to the local solana validator.
ESCROW_PROGRAM_ID=your_generated_escrow_program_id
WITHDRAW_PROGRAM_ID=your_generated_withdraw_program_id

