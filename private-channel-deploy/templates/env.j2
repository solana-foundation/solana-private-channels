# Rendered by Ansible — do not edit by hand. Source: private-channel-deploy/templates/env.j2
# Consumed by docker-compose via --env-file. Mirrors keys from .env.example.
# Secrets are NOT here: each container reads its own from {{ host_data_dir }}/secrets/<service>/
# (see secret_files in vars/common.yml). Their keys stay present but empty, so
# compose does not warn and `${X:-default}` keys take their non-secret default.

# --- Image tagging ---
PRIVATE_CHANNEL_VERSION={{ image_tag }}

# --- RPC + program IDs ---
# Off localnet the RPC URLs carry provider API keys, so they are secret files.
LOCAL_VALIDATOR_RPC_URL={{ 'http://validator:8899' if network == 'localnet' else '' }}
DEVNET_RPC_URL={{ rpc_url if network == 'localnet' else '' }}
# Archival Solana fallback for the withdraw operator and solana indexer. Rendered
# present-but-empty when unset, so compose does not warn; the app treats empty
# as unset and stays single-endpoint. Set on devnet/mainnet for double-spend
# corroboration; leave empty on localnet (no archival peer).
DEVNET_FALLBACK_RPC_URL=

# --- Yellowstone gRPC (indexer-solana real-time stream) ---
# localnet ignores these (compose hardcodes http://validator:10000); devnet/mainnet uses both.
DEVNET_YELLOWSTONE_ENDPOINT={{ yellowstone_endpoint | default('') }}
INDEXER_YELLOWSTONE_TOKEN=
# Compiled into the programs and every client; only the localnet validator reads these.
ESCROW_PROGRAM_ID={{ compiled_escrow_program_id }}
WITHDRAW_PROGRAM_ID={{ compiled_withdraw_program_id }}
# Bundled localnet validator boot mode. Explicit, not hardcoded: `validator_reset`
# (vars/common.yml, default true) → `--reset` boots from genesis every redeploy
# (the indexer reconciliation rationale in deploy.yml depends on this); set false
# to preserve the validator ledger across redeploys — the deploy analogue of
# `make docker-up-persist`. Only safe when Postgres is NOT wiped in lockstep.
VALIDATOR_RESET_FLAG={{ '--reset' if (validator_reset | default(true) | bool) else '' }}

# --- Postgres (passwords are secret files) ---
POSTGRES_DB={{ postgres_db }}
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD=
POSTGRES_REPLICATION_USER={{ postgres_replication_user }}
POSTGRES_REPLICATION_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_AUTH_RUNTIME_PASSWORD=
POSTGRES_AUTH_OWNER_PASSWORD=
POSTGRES_GATEWAY_PASSWORD=
POSTGRES_MONITORING_PASSWORD=
POSTGRES_GRAFANA_PASSWORD=
POSTGRES_INDEXER_USER={{ postgres_indexer_user }}
POSTGRES_INDEXER_PASSWORD=
POSTGRES_INDEXER_DB={{ postgres_indexer_db }}

# --- Solana Private Channels node ---
PRIVATE_CHANNEL_WRITE_PORT={{ write_port }}
PRIVATE_CHANNEL_READ_PORT={{ read_port }}
PRIVATE_CHANNEL_SIGVERIFY_QUEUE_SIZE=10000000
PRIVATE_CHANNEL_SIGVERIFY_WORKERS=32
PRIVATE_CHANNEL_WRITE_MAX_CONNECTIONS=1000000
PRIVATE_CHANNEL_READ_MAX_CONNECTIONS=100000
PRIVATE_CHANNEL_PG_MAX_CONNECTIONS=32
PRIVATE_CHANNEL_MAX_TX_PER_BATCH=64
PRIVATE_CHANNEL_BATCH_DEADLINE_MS=10
PRIVATE_CHANNEL_BATCH_CHANNEL_CAPACITY=16
PRIVATE_CHANNEL_MAX_SVM_WORKERS=8
# Channel admin (fee payer, mint authority, fee treasury), NOT the escrow
# Instance.admin, a separate offline key that never reaches this host. The node
# also accepts extra_admin_keys, for the admin rotation overlap.
{% set _extra = extra_admin_keys | default([]) %}
{% if _extra is string %}{% set _extra = _extra.split(',') | map('trim') | select | list %}{% endif %}
PRIVATE_CHANNEL_ADMIN_KEYS={{ ([pc_admin_pubkey | default('admin_pubkey', true)] + _extra) | join(',') }}
# Signer backends. operator-solana gets ADMIN_* only; the withdraw operator also
# gets OPERATOR_*, its own release key. Only the selected backend's vars render.
ADMIN_SIGNER={{ admin_signer | default('memory') }}
OPERATOR_SIGNER={{ operator_signer | default('memory') }}
# Always present (a memory key is a secret file; remote signers leave it blank), since the
# base compose files read ${ADMIN_PRIVATE_KEY} for every backend.
ADMIN_PRIVATE_KEY=
OPERATOR_PRIVATE_KEY=
{% if admin_signer | default('memory') == 'vault' %}
ADMIN_VAULT_ADDR={{ admin_vault_addr }}
ADMIN_VAULT_TOKEN=
ADMIN_VAULT_KEY_NAME={{ admin_vault_key_name }}
ADMIN_VAULT_PUBKEY={{ pc_admin_pubkey }}
{% elif admin_signer == 'turnkey' %}
ADMIN_TURNKEY_API_PUBLIC_KEY={{ admin_turnkey_api_public_key }}
ADMIN_TURNKEY_API_PRIVATE_KEY=
ADMIN_TURNKEY_ORGANIZATION_ID={{ admin_turnkey_organization_id }}
ADMIN_TURNKEY_PRIVATE_KEY_ID={{ admin_turnkey_private_key_id }}
ADMIN_TURNKEY_PUBKEY={{ pc_admin_pubkey }}
{% elif admin_signer == 'privy' %}
ADMIN_PRIVY_APP_ID={{ admin_privy_app_id }}
ADMIN_PRIVY_APP_SECRET=
ADMIN_PRIVY_WALLET_ID={{ admin_privy_wallet_id }}
{% endif %}
{% if operator_signer | default('memory') == 'vault' %}
OPERATOR_VAULT_ADDR={{ operator_vault_addr }}
OPERATOR_VAULT_TOKEN=
OPERATOR_VAULT_KEY_NAME={{ operator_vault_key_name }}
OPERATOR_VAULT_PUBKEY={{ pc_operator_pubkey }}
{% elif operator_signer == 'turnkey' %}
OPERATOR_TURNKEY_API_PUBLIC_KEY={{ operator_turnkey_api_public_key }}
OPERATOR_TURNKEY_API_PRIVATE_KEY=
OPERATOR_TURNKEY_ORGANIZATION_ID={{ operator_turnkey_organization_id }}
OPERATOR_TURNKEY_PRIVATE_KEY_ID={{ operator_turnkey_private_key_id }}
OPERATOR_TURNKEY_PUBKEY={{ pc_operator_pubkey }}
{% elif operator_signer == 'privy' %}
OPERATOR_PRIVY_APP_ID={{ operator_privy_app_id }}
OPERATOR_PRIVY_APP_SECRET=
OPERATOR_PRIVY_WALLET_ID={{ operator_privy_wallet_id }}
{% endif %}
# Permanent delegate on every channel mint. One var feeds the node and the operator so
# they cannot drift. Required: deploy.yml refuses to run without it.
PRIVATE_CHANNEL_PERMANENT_DELEGATE={{ permanent_delegate | default('') }}
OPERATOR_PERMANENT_DELEGATE={{ permanent_delegate | default('') }}
# Compliance ATA owner, rendered only when set; blank or unset refuses every delegate move.
{% if compliance_owner | default('') %}PRIVATE_CHANNEL_COMPLIANCE_OWNER={{ compliance_owner }}{% endif %}


# Escrow instance for every worker: escrow_instance_id, else the PDA a previous
# render left in .env. Blank only on a localnet first boot, where the workers are
# not deployed; they refuse a blank or all-ones id.
COMMON_ESCROW_INSTANCE_ID={{ escrow_instance_id | default('', true) or escrow_instance_id_pda | default('') }}

# Escrow instance confidential keys (secret, optional until an escrow account is
# configured): a secret file for indexer-solana and both operators, like the others.
ESCROW_CONFIDENTIAL_KEYS=
# The instance's pinned ElGamal pubkey (not secret); when set the services require
# the matching keys above.
ESCROW_CONFIDENTIAL_PUBKEY={{ escrow_confidential_pubkey | default('') | trim }}

# --- Gateway ---
GATEWAY_PORT={{ gateway_port }}
GATEWAY_WRITE_URL=http://write-node:{{ write_port }}
GATEWAY_READ_URL=http://read-node:{{ read_port }}
GATEWAY_URL=http://gateway:{{ gateway_port }}
# The gateway's second listener, for the operator's own services: no RBAC, and
# transaction errors are not collapsed. Compose never publishes this port, so it
# exists on the Docker network and nowhere else. That absence is the whole
# boundary: publish it and any caller can read the errors the public port hides.
GATEWAY_INTERNAL_PORT={{ gateway_internal_port }}
GATEWAY_INTERNAL_URL=http://gateway:{{ gateway_internal_port }}
# Max seconds one forwarded request may take, including the client's download.
GATEWAY_UPSTREAM_TIMEOUT_SECS={{ gateway_upstream_timeout_secs }}
# Max public reads in flight; more get a 503 so writes keep free connection slots.
GATEWAY_MAX_FORWARDED_READS={{ gateway_max_forwarded_reads }}
# Optional, both or neither: refuse public withdrawals the escrow whitelist would refuse.
GATEWAY_WHITELIST_RPC_URL=
GATEWAY_WHITELIST_INSTANCE={{ gateway_whitelist_instance | default('') }}
# Max Mainnet reads per second the check makes; past it, withdrawals go unchecked.
GATEWAY_WHITELIST_READS_PER_SECOND={{ gateway_whitelist_reads_per_second }}

# --- Auth ---
# Setting JWT_SECRET non-empty makes the gateway enforce RBAC on
# ACCOUNT_GATED_METHODS (getAccountInfo, getSignaturesForAddress, …) and
# collapses transaction errors for every caller but an Operator. The operator
# services don't carry a JWT: they use GATEWAY_INTERNAL_URL above, which is
# exempt from both. `gateway_enforce_jwt: false` still exists to turn RBAC off
# wholesale for a single-host self-test. Production envs leave it true (the
# default in common.yml).
AUTH_PORT={{ auth_port }}
# Secret files for gateway and auth; JWT_SECRET_PREVIOUS is set only during a rotation.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
# With RBAC on, the gateway refuses to start on a blank JWT_SECRET instead of
# silently serving without auth.
GATEWAY_REQUIRE_JWT={{ '1' if (gateway_enforce_jwt | default(true) | bool) else '' }}
CORS_ALLOWED_ORIGIN=https://{{ domain }}
AUTH_DATABASE_MAX_CONNECTIONS=10

# --- Streamer ---
STREAMER_PORT={{ streamer_port }}

# --- Grafana / alerting ---
# Secret files; blank here makes compose fall back to the no-op webhook.
GF_ADMIN_PASSWORD=
ALERT_WEBHOOK_URL=
RECONCILIATION_WEBHOOK_URL=
