{
  "name": "private-channel",
  "networks": {
    "private-channel-network": {
      "driver": "bridge",
      "ipam": {},
      "name": "private-channel_private-channel-network"
    }
  },
  "services": {
    "auth": {
      "build": {
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/usr/local/bin/auth"
      ],
      "container_name": "private-channel-auth",
      "depends_on": {
        "auth-migrate": {
          "condition": "service_completed_successfully",
          "required": true
        },
        "postgres-primary": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_ARGON2_MAX_CONCURRENCY": "4",
        "AUTH_DATABASE_MAX_CONNECTIONS": "10",
        "AUTH_DATABASE_URL": "postgres://private_channel_auth_runtime:@postgres-primary:5432/private_channel",
        "AUTH_HEADER_READ_TIMEOUT_SECS": "10",
        "AUTH_MAX_CONNECTIONS": "1024",
        "AUTH_MAX_CONNECTIONS_PER_IP": "64",
        "AUTH_PORT": "8903",
        "AUTH_RATE_LIMIT_BURST": "10",
        "AUTH_RATE_LIMIT_PER_SECOND": "5",
        "AUTH_REQUEST_TIMEOUT_SECS": "15",
        "AUTH_TCP_KEEPALIVE_IDLE_SECS": "60",
        "AUTH_TCP_KEEPALIVE_INTERVAL_SECS": "15",
        "AUTH_USERNAME_FAILED_LOGINS_PER_MINUTE": "5",
        "CORS_ALLOWED_ORIGIN": "*",
        "JWT_SECRET": "",
        "RUST_LOG": "info"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 5,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:8903/health || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "private-channel-app:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8903",
          "target": 8903
        }
      ],
      "profiles": [
        "auth"
      ],
      "restart": "unless-stopped",
      "ulimits": {
        "nofile": {
          "hard": 65536,
          "soft": 65536
        }
      }
    },
    "auth-migrate": {
      "build": {
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/usr/local/bin/auth-admin",
        "migrate"
      ],
      "container_name": "private-channel-auth-migrate",
      "depends_on": {
        "postgres-primary": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_DATABASE_URL": "postgres://private_channel_auth_owner:@postgres-primary:5432/private_channel",
        "RUST_LOG": "info"
      },
      "image": "private-channel-app:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "profiles": [
        "auth"
      ],
      "restart": "no"
    },
    "blackbox-exporter": {
      "command": null,
      "container_name": "private-channel-blackbox-exporter",
      "entrypoint": null,
      "healthcheck": {
        "interval": "30s",
        "retries": 5,
        "start_period": "10s",
        "test": [
          "CMD-SHELL",
          "wget --spider -q http://localhost:9115/-/healthy || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "prom/blackbox-exporter:v0.25.0",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "restart": "unless-stopped"
    },
    "cadvisor": {
      "command": null,
      "container_name": "private-channel-cadvisor",
      "entrypoint": null,
      "image": "gcr.io/cadvisor/cadvisor:v0.49.1",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8080",
          "target": 8080
        }
      ],
      "privileged": true,
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "/",
          "target": "/rootfs",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "/var/run",
          "target": "/var/run",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "/sys",
          "target": "/sys",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "/var/lib/docker/",
          "target": "/var/lib/docker",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "/dev/disk/",
          "target": "/dev/disk",
          "type": "bind"
        }
      ]
    },
    "gateway": {
      "build": {
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/usr/local/bin/gateway"
      ],
      "container_name": "private-channel-gateway",
      "depends_on": {
        "read-node": {
          "condition": "service_started",
          "required": true
        },
        "write-node": {
          "condition": "service_started",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "AUTH_DATABASE_MAX_CONNECTIONS": "10",
        "AUTH_DATABASE_URL": "postgres://private_channel_gateway:@postgres-primary:5432/private_channel",
        "GATEWAY_INTERNAL_PORT": "8904",
        "GATEWAY_MAX_CONNECTIONS": "1024",
        "GATEWAY_MAX_CONNECTIONS_PER_IP": "64",
        "GATEWAY_MAX_FORWARDED_READS": "768",
        "GATEWAY_PORT": "8899",
        "GATEWAY_RATE_LIMIT_BURST": "100",
        "GATEWAY_RATE_LIMIT_PER_SECOND": "50",
        "GATEWAY_READ_URL": "http://read-node:8901",
        "GATEWAY_UPSTREAM_TIMEOUT_SECS": "30",
        "GATEWAY_WHITELIST_INSTANCE": "",
        "GATEWAY_WHITELIST_READS_PER_SECOND": "20",
        "GATEWAY_WHITELIST_RPC_URL": "",
        "GATEWAY_WRITE_URL": "http://write-node:8900",
        "JWT_SECRET": "",
        "METRICS_PORT": "9101",
        "PRIVATE_CHANNEL_PG_MAX_CONNECTIONS": "32",
        "RUST_LOG": "info"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 5,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:8899/health || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "private-channel-app:latest",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "protocol": "tcp",
          "published": "8899",
          "target": 8899
        }
      ],
      "restart": "unless-stopped",
      "ulimits": {
        "nofile": {
          "hard": 65536,
          "soft": 65536
        }
      }
    },
    "grafana": {
      "build": {
        "args": {
          "GRAFANA_VERSION": "11.4.0"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile.grafana"
      },
      "command": null,
      "container_name": "private-channel-grafana",
      "entrypoint": null,
      "environment": {
        "ALERT_CONTACT_TYPE": "webhook",
        "ALERT_WEBHOOK_URL": "http://localhost:9/no-op",
        "GF_SECURITY_ADMIN_PASSWORD": "",
        "GF_SERVER_ROOT_URL": "http://localhost:3000",
        "GF_USERS_ALLOW_SIGN_UP": "false",
        "POSTGRES_GRAFANA_PASSWORD": "",
        "POSTGRES_INDEXER_DB": "indexer",
        "POSTGRES_INDEXER_HOST": "postgres-indexer",
        "PROMETHEUS_URL": "http://prometheus:9090"
      },
      "healthcheck": {
        "interval": "30s",
        "retries": 5,
        "start_period": "20s",
        "test": [
          "CMD-SHELL",
          "wget --spider -q http://localhost:3000/api/health || exit 1"
        ],
        "timeout": "3s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "37429",
          "target": 3000
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "source": "grafana-data",
          "target": "/var/lib/grafana",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/monitoring/provisioning",
          "target": "/etc/grafana/provisioning",
          "type": "bind"
        },
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/monitoring/dashboards",
          "target": "/var/lib/grafana/dashboards",
          "type": "bind"
        }
      ]
    },
    "indexer-private-channel": {
      "build": {
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/bin/sh",
        "-c",
        "/usr/local/bin/indexer \\\n  --config /config/local/indexer-private-channel.toml \\\n  -v \\\n  indexer\n"
      ],
      "container_name": "private-channel-indexer-private-channel",
      "depends_on": {
        "gateway": {
          "condition": "service_started",
          "required": true
        },
        "postgres-indexer": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "deploy": {
        "placement": {},
        "replicas": 1,
        "resources": {}
      },
      "entrypoint": null,
      "environment": {
        "ALERT_WEBHOOK_URL": "http://localhost:9/no-op",
        "COMMON_RPC_URL": "http://read-node:8901",
        "DATABASE_URL": "postgres://private_channel_indexer:@postgres-indexer:5432/indexer",
        "METRICS_PORT": "9100",
        "RUST_LOG": "info,private_channel_indexer=debug"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 5,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:9100/health || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "private-channel-app:latest",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/indexer/config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "indexer-solana": {
      "build": {
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/bin/sh",
        "-c",
        "/usr/local/bin/indexer \\\n  --config /config/local/indexer-solana.toml \\\n  -v \\\n  indexer\n"
      ],
      "container_name": "private-channel-indexer-solana",
      "depends_on": {
        "postgres-indexer": {
          "condition": "service_healthy",
          "required": true
        },
        "validator": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "deploy": {
        "placement": {},
        "replicas": 1,
        "resources": {}
      },
      "entrypoint": null,
      "environment": {
        "ALERT_WEBHOOK_URL": "http://localhost:9/no-op",
        "COMMON_ESCROW_INSTANCE_ID": null,
        "COMMON_RPC_URL": "http://validator:8899",
        "COMMON_SOURCE_RPC_URL": "http://read-node:8901",
        "DATABASE_URL": "postgres://private_channel_indexer:@postgres-indexer:5432/indexer",
        "INDEXER_YELLOWSTONE_ENDPOINT": "http://validator:10000",
        "METRICS_PORT": "9100",
        "RUST_LOG": "info,private_channel_indexer=debug"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 5,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:9100/health || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "private-channel-app:latest",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/indexer/config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "operator-private-channel": {
      "build": {
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/bin/sh",
        "-c",
        "/usr/local/bin/indexer \\\n  --config /config/local/operator-private-channel.toml \\\n  -v \\\n  operator\n"
      ],
      "container_name": "private-channel-operator-private-channel",
      "depends_on": {
        "postgres-indexer": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ADMIN_PRIVATE_KEY": "GOLDENadminkey",
        "ADMIN_SIGNER": "memory",
        "ALERT_WEBHOOK_URL": "http://localhost:9/no-op",
        "COMMON_ESCROW_INSTANCE_ID": null,
        "COMMON_FALLBACK_RPC_URL": "http://validator-fallback:8899",
        "COMMON_RPC_URL": "http://validator:8899",
        "COMMON_SOURCE_RPC_URL": "http://gateway:8904",
        "DATABASE_URL": "postgres://private_channel_indexer:@postgres-indexer:5432/indexer",
        "METRICS_PORT": "9103",
        "OPERATOR_PERMANENT_DELEGATE": "",
        "OPERATOR_PRIVATE_KEY": "GOLDENadminkey",
        "OPERATOR_SIGNER": "memory",
        "RUST_LOG": "info,private_channel_indexer=debug"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 5,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:9103/health || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "private-channel-app:latest",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9103",
          "target": 9103
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/indexer/config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "operator-solana": {
      "build": {
        "args": {
          "PNPM_VERSION": "10.15.1",
          "SOLANA_VERSION": "4.2.2"
        },
        "context": "REPO",
        "dockerfile": "Dockerfile"
      },
      "command": [
        "/bin/sh",
        "-c",
        "/usr/local/bin/indexer \\\n  --config /config/local/operator-solana.toml \\\n  -v \\\n  operator\n"
      ],
      "container_name": "private-channel-operator-solana",
      "depends_on": {
        "postgres-indexer": {
          "condition": "service_healthy",
          "required": true
        },
        "write-node": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "ADMIN_PRIVATE_KEY": "GOLDENadminkey",
        "ADMIN_SIGNER": "memory",
        "ALERT_WEBHOOK_URL": "http://localhost:9/no-op",
        "COMMON_ESCROW_INSTANCE_ID": null,
        "COMMON_RPC_URL": "http://gateway:8904",
        "COMMON_SOURCE_RPC_URL": "http://validator:8899",
        "DATABASE_URL": "postgres://private_channel_indexer:@postgres-indexer:5432/indexer",
        "METRICS_PORT": "9102",
        "OPERATOR_PERMANENT_DELEGATE": "",
        "OPERATOR_PRIVATE_KEY": "GOLDENadminkey",
        "OPERATOR_RECONCILIATION_WEBHOOK_URL": "http://localhost:9/no-op",
        "OPERATOR_SIGNER": "memory",
        "RUST_LOG": "info,private_channel_indexer=debug"
      },
      "healthcheck": {
        "interval": "10s",
        "retries": 5,
        "start_period": "30s",
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:9102/health || exit 1"
        ],
        "timeout": "3s"
      },
      "image": "private-channel-app:latest",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "ports": [
        {
          "host_ip": "127.0.0.1",
          "mode": "ingress",
          "protocol": "tcp",
          "published": "9102",
          "target": 9102
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/indexer/config",
          "target": "/config",
          "type": "bind"
        }
      ]
    },
    "pg-backup-indexer": {
      "command": [
        "/usr/local/bin/pg-backup.sh"
      ],
      "container_name": "private-channel-pg-backup-indexer",
      "depends_on": {
        "postgres-indexer": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "PGHOST": "postgres-indexer",
        "PGPASSWORD": "",
        "PGUSER": "private_channel_indexer",
        "PG_BACKUP_INTERVAL_HOURS": "6",
        "PG_BACKUP_RETENTION_COUNT": "3"
      },
      "image": "postgres:16-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "source": "postgres-indexer-basebackups",
          "target": "/backups",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "postgres-indexer-wal-archive",
          "target": "/wal_archive",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/scripts/pg-backup.sh",
          "target": "/usr/local/bin/pg-backup.sh",
          "type": "bind"
        }
      ]
    },
    "pg-backup-primary": {
      "command": [
        "/usr/local/bin/pg-backup.sh"
      ],
      "container_name": "private-channel-pg-backup-primary",
      "depends_on": {
        "postgres-primary": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "PGHOST": "postgres-primary",
        "PGPASSWORD": "",
        "PGUSER": "replicator",
        "PG_BACKUP_INTERVAL_HOURS": "6",
        "PG_BACKUP_RETENTION_COUNT": "3"
      },
      "image": "postgres:16-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "5",
          "max-size": "100m"
        }
      },
      "networks": {
        "private-channel-network": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "source": "postgres-primary-basebackups",
          "target": "/backups",
          "type": "volume",
          "volume": {}
        },
        {
          "source": "postgres-primary-wal-archive",
          "target": "/wal_archive",
          "type": "volume",
          "volume": {}
        },
        {
          "bind": {},
          "read_only": true,
          "source": "REPO/scripts/pg-backup.sh",
          "target": "/usr/local/bin/pg-backup.sh",
          "type": "bind"
        }
      ]
    },
    "postgres-indexer": {
      "command": [
        "postgres",
        "-c",
        "wal_level=replica",
        "-c",
        "archive_mode=on",
        "-c",
        "archive_command=cp %p /wal_archive/%f.tmp && mv /wal_archive/%f.tmp /wal_archive/%f",
        "-c",
        "listen_addresses=*"
      ],
      "container_name": "private-channel-postgres-indexer",
      "entrypoint": [
        "sh",
        "-c",
        "chown postgres:postgres /wal_archive || echo 'WARNING: could not chown /wal_archive' >&2; exec docker-entrypoint.sh \"$$@\"",
        "--"
